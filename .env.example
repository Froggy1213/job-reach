# --- Job Reach: optional configuration -------------------------------------
# Nothing here is required. The plugin works with zero configuration; these are
# the knobs worth knowing about. Copy to ~/.hermes/.env to make them permanent.

# Where job data lives: the SQLite database and the optional scraping venv.
# Default: $HERMES_HOME/plugin-data/job-reach
# JOBREACH_HOME=/absolute/path/to/job-reach-data

# Explicit database file (overrides the location inside JOBREACH_HOME).
# JOBREACH_DB=/absolute/path/to/jobs.db

# Interpreter used to run the engine. Set this if you manage a venv yourself
# instead of using `hermes job-reach setup`.
# JOBREACH_PYTHON=/absolute/path/to/venv/bin/python

# The uv binary `job_setup` uses. Auto-detected (PATH, ~/.hermes/bin/uv).
# JOBREACH_UV=/opt/homebrew/bin/uv

# Obsidian vault that job notes are written into. Auto-detected when unset.
# OBSIDIAN_VAULT_PATH=/Users/you/Obsidian/YourVault

# LLM-based relevance filtering (job_search with validation="llm").
# Falls back to DEEPSEEK_API_KEY, then OPENAI_API_KEY.
# JOBREACH_LLM_API_KEY=sk-...
# JOBREACH_LLM_BASE_URL=https://api.deepseek.com/v1

# --- Hermes-side ------------------------------------------------------------
# Enable the plugin (normally done by `hermes plugins enable job-reach`).
# HERMES_ENABLE_PROJECT_PLUGINS=true   # only for the in-repo ./.hermes/plugins copy
# HERMES_PLUGINS_DEBUG=1               # verbose plugin discovery on stderr
